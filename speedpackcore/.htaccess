# Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <Files ~ "(?i)^.*\.(jpg|jpeg|gif|png|svg|webp|ico|css|js|woff|woff2|ttf|eot)$">
        Allow from all
    </Files>
</IfModule>

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
    <Files ~ "(?i)^.*\.(jpg|jpeg|gif|png|svg|webp|ico|css|js|woff|woff2|ttf|eot)$">
        Require all granted
    </Files>
</IfModule>

# The prefetch worker may claim the whole shop, not only its own folder.
# Without mod_headers (or on nginx) the browser refuses the registration and
# prefetching carries on with plain prefetch hints.
<IfModule mod_headers.c>
    <FilesMatch "^sw(\.min)?\.js$">
        Header set Service-Worker-Allowed "/"
    </FilesMatch>
</IfModule>
